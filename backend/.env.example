@'
# Copy to .env (never commit). Real values live in the host secret store in prod.
ENV=dev
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://claimcheck_app:***@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
BUCKET=claim-docs

NVIDIA_API_KEY=
NVIDIA_MODEL=            # exact model id from build.nvidia.com
'@ | Set-Content backend\.env.example